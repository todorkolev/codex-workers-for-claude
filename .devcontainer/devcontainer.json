{
  "name": "Codex Workers for Claude",

  // TypeScript + Node 20 base (matches the spec's node20 build target, §34).
  // Ships with node, npm, git, and common CLI tooling preinstalled.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20",

  "features": {
    // The plugin distributes via a GitHub-hosted marketplace (§5); gh is handy
    // for releases and for `gh repo` operations during development.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Installs esbuild + the Claude Code and Codex CLIs the plugin drives at runtime (§10).
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },

  // Codex workers run in isolated git worktrees (§24); keep the workspace on a
  // named volume so worktrees and the .codex-workers artifact tree (§14) persist
  // and stay fast across container rebuilds.
  "mounts": [
    "source=codex-workers-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],

  // node_modules is owned by the volume; let the container user own it.
  "postStartCommand": "sudo chown -R node:node ${containerWorkspaceFolder}/node_modules || true",

  "remoteUser": "node"
}
